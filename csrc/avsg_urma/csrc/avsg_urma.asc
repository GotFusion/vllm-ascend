namespace avsg_urma {
using hixl::aiv::HixlDevXferDesc;
static_assert(sizeof(HixlDevXferDesc) == 24 && offsetof(HixlDevXferDesc, len) == 16 &&
              offsetof(HixlDevXferDesc, reserved) == 20, "HIXL descriptor ABI changed");

constexpr uint32_t kDescriptorLanes = 32;
constexpr uint32_t kDescriptorTileTokens = 32;
constexpr uint32_t kDescriptorTileBytes = kDescriptorTileTokens * 2 * sizeof(HixlDevXferDesc);
static_assert(kDescriptorTileTokens * sizeof(HixlDevXferDesc) % 128 == 0,
              "Full descriptor tiles must start on cache-line boundaries");

__aicore__ inline void Status(uint64_t addr, uint64_t code, uint64_t phase, uint64_t completed,
                              AscendC::LocalTensor<uint32_t> local, uint32_t contextDetail = kContextValid)
{
    // Publish one complete final row per core. Reuse UB only after the last
    // descriptor DMA has completed; do not mix provisional/final scalar GM stores.
    for (uint32_t i = 0; i < kStatusBytes / sizeof(uint32_t); ++i) local.SetValue(i, 0);
    local.SetValue(0, static_cast<uint32_t>(code));
    local.SetValue(1, static_cast<uint32_t>(code >> 32));
    local.SetValue(2, static_cast<uint32_t>(phase));
    local.SetValue(3, static_cast<uint32_t>(phase >> 32));
    local.SetValue(4, static_cast<uint32_t>(completed));
    local.SetValue(5, static_cast<uint32_t>(completed >> 32));
    local.SetValue(8, contextDetail);
    AscendC::SetFlag<AscendC::HardEvent::S_MTE3>(2);
    AscendC::WaitFlag<AscendC::HardEvent::S_MTE3>(2);
    AscendC::GlobalTensor<uint32_t> dst;
    dst.SetGlobalBuffer(reinterpret_cast<__gm__ uint32_t *>(addr));
    AscendC::DataCopyExtParams copy{1, static_cast<uint32_t>(kStatusBytes), 0, 0, 0};
    AscendC::DataCopyPad(dst, local, copy);
    AscendC::SetFlag<AscendC::HardEvent::MTE3_S>(1);
    AscendC::WaitFlag<AscendC::HardEvent::MTE3_S>(1);
}

__simt_callee__ inline void Invalidate(uint64_t addr, uint64_t bytes)
{
    asc_threadfence();
    const uint64_t end = addr + bytes;
    for (uint64_t line = addr & ~127ULL; line < end; line += 128) {
        asc_dcci_single(reinterpret_cast<__gm__ void *>(line));
    }
    asc_threadfence();
}

__simt_callee__ inline void MakeUbDesc(__ubuf__ uint64_t *out, uint64_t remote, uint64_t local,
                                      uint32_t bytes)
{
    out[0] = remote;
    out[1] = local;
    out[2] = bytes; // high 32 bits (reserved) = 0
}

// Each lane writes one token's 1/2 descriptors into its own UB slice. All VF
// arguments are scalar/pointer types, following the HIXL raw ASC entry pattern.
__simt_vf__ __launch_bounds__(kDescriptorLanes) inline void BuildDescriptorTileVf(
    __ubuf__ uint64_t *ub, __gm__ const Context *ctx, __gm__ const int32_t *mapping,
    __gm__ const int32_t *counts, uint64_t groups, uint64_t entries,
    uint64_t firstToken, uint32_t tokens, uint64_t firstGroup, uint64_t firstPrefix, uint32_t write)
{
    auto block = cooperative_groups::this_thread_block();
    const uint32_t lane = static_cast<uint32_t>(block.thread_rank());
    if (lane >= tokens) return;
    const uint64_t index = firstToken + lane;
    uint64_t prefix = firstPrefix;
    const uint64_t perToken = ctx->hasRope ? 2 : 1;
    for (uint64_t group = firstGroup; group < groups; ++group) {
        const uint64_t count = static_cast<uint64_t>(counts[group]);
        if (index >= prefix + count) {
            prefix += count;
            continue;
        }
        const uint64_t entry = (group * entries + index - prefix) * 2;
        const uint64_t src = static_cast<uint64_t>(mapping[entry]);
        const uint64_t dst = static_cast<uint64_t>(mapping[entry + 1]);
        const uint64_t srcBlock = src / ctx->blockSize, offset = src % ctx->blockSize;
        auto desc = ub + lane * perToken * 3;
        const uint64_t localKv = ctx->localKv + dst * ctx->kvDim * ctx->elementBytes;
        MakeUbDesc(desc, ctx->remoteKv + srcBlock * ctx->kvStride0 + offset * ctx->kvStride1,
                   localKv, ctx->kvDim * ctx->elementBytes);
        if (!write) Invalidate(localKv, ctx->kvDim * ctx->elementBytes);
        if (ctx->hasRope) {
            const uint64_t localRope = ctx->localRope + dst * ctx->ropeDim * ctx->elementBytes;
            MakeUbDesc(desc + 3, ctx->remoteRope + srcBlock * ctx->ropeStride0 + offset * ctx->ropeStride1,
                       localRope, ctx->ropeDim * ctx->elementBytes);
            if (!write) Invalidate(localRope, ctx->ropeDim * ctx->elementBytes);
        }
        return;
    }
    // Should be unreachable after Host validation. A corrupt mapping must not
    // turn stale UB contents into a valid remote request.
    MakeUbDesc(ub + lane * perToken * 3, 0, 0, 0);
    if (ctx->hasRope) MakeUbDesc(ub + lane * perToken * 3 + 3, 0, 0, 0);
}

struct TokenRange {
    uint64_t first;
    uint64_t count;
};

__aicore__ inline TokenRange PartitionTokens(uint64_t total, uint64_t channels, uint32_t core)
{
    const uint64_t tiles = (total + kDescriptorTileTokens - 1) / kDescriptorTileTokens;
    const uint64_t base = tiles / channels, extra = tiles % channels;
    const uint64_t firstTile = core * base + (core < extra ? core : extra);
    const uint64_t lastTile = firstTile + base + (core < extra ? 1 : 0);
    if (firstTile == lastTile) return {total, 0};
    const uint64_t first = firstTile * kDescriptorTileTokens;
    const uint64_t end = lastTile * kDescriptorTileTokens;
    return {first, (end < total ? end : total) - first};
}

// Each core publishes its own cache-line-aligned descriptor range.
__aicore__ inline TokenRange BuildDescriptors(LaunchArgs args, uint32_t core, bool publishStatus = true,
                                             uint32_t write = 0)
{
    auto ctx = reinterpret_cast<__gm__ const Context *>(args.context);
    const uint64_t result = args.status + core * kStatusBytes;
    AscendC::TPipe pipe;
    AscendC::TBuf<AscendC::TPosition::VECCALC> buffer;
    pipe.InitBuffer(buffer, kDescriptorTileBytes);
    auto local = buffer.Get<uint32_t>();
    if (ctx->magic != kMagic || ctx->version != kVersion || ctx->channels != args.channels ||
        ctx->batch < 2 || ctx->batch > kMaxBatch || args.channels == 0 || core >= ctx->channels) {
        if (publishStatus) Status(result, kBadContext, kValidate, 0, local);
        return {0, 0};
    }
    const uint64_t perToken = ctx->hasRope ? 2 : 1;
    const TokenRange range = PartitionTokens(args.total, args.channels, core);
    auto ub = reinterpret_cast<__ubuf__ uint64_t *>(local.GetPhyAddr());
    auto mapping = reinterpret_cast<__gm__ const int32_t *>(args.mapping);
    auto counts = reinterpret_cast<__gm__ const int32_t *>(args.counts);
    uint64_t group = 0, prefix = 0, completed = 0;
    while (completed < range.count) {
        const uint64_t first = range.first + completed;
        const uint64_t remaining = range.count - completed;
        const uint32_t tokens = static_cast<uint32_t>(remaining < kDescriptorTileTokens ?
                                                     remaining : kDescriptorTileTokens);
        while (group < args.groups && prefix + static_cast<uint64_t>(counts[group]) <= first) {
            prefix += static_cast<uint64_t>(counts[group++]);
        }
        // Same VF algorithm is exercised lane-by-lane in the CPU harness.
#ifdef AVSG_URMA_CPU_TEST
        for (uint32_t lane = 0; lane < kDescriptorLanes; ++lane) {
            threadIdx.x = lane;
            BuildDescriptorTileVf(ub, ctx, mapping, counts, args.groups, args.entries, first, tokens, group, prefix,
                                  write);
        }
        threadIdx.x = 0;
#else
        asc_vf_call<BuildDescriptorTileVf>(dim3(kDescriptorLanes), ub, ctx, mapping, counts,
                                         args.groups, args.entries, first, tokens, group, prefix, write);
#endif
        // Match HIXL's V->MTE3 handshake before DMA and MTE3->S wait before
        // reusing this single UB buffer or declaring the generated tile ready.
        AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(0);
        AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(0);
        AscendC::GlobalTensor<uint32_t> dst;
        dst.SetGlobalBuffer(reinterpret_cast<__gm__ uint32_t *>(
            args.scratch + first * perToken * sizeof(HixlDevXferDesc)));
        AscendC::DataCopyExtParams copy{1, static_cast<uint32_t>(tokens * perToken * sizeof(HixlDevXferDesc)), 0, 0, 0};
        AscendC::DataCopyPad(dst, local, copy);
        AscendC::SetFlag<AscendC::HardEvent::MTE3_S>(1);
        AscendC::WaitFlag<AscendC::HardEvent::MTE3_S>(1);
        completed += tokens;
    }
    if (publishStatus) Status(result, 0, kDescriptorsReady, completed, local);
    return range;
}

// Maintenance only: after the HIXL kernel has drained READs on the same stream,
// discard stale local cache lines before subsequent consumers use selection.
__simt_vf__ __launch_bounds__(1) inline void FinishDescriptors(LaunchArgs args, uint32_t core)
{
    auto ctx = reinterpret_cast<__gm__ const Context *>(args.context);
    auto desc = reinterpret_cast<__gm__ const HixlDevXferDesc *>(args.scratch);
    const uint64_t count = args.total * (ctx->hasRope ? 2 : 1);
    for (uint64_t i = core; i < count; i += args.channels) {
        Invalidate(desc[i].local, desc[i].len);
    }
}

__aicore__ inline bool TokenFits(uint64_t src, uint64_t blockSize, uint64_t stride0, uint64_t stride1,
                                uint64_t regionBytes, uint64_t tokenBytes)
{
    const uint64_t block = src / blockSize;
    const uint64_t offset = src % blockSize;
    if (block > regionBytes / stride0 || offset > regionBytes / stride1) return false;
    const uint64_t blockBytes = block * stride0;
    const uint64_t offsetBytes = offset * stride1;
    return offsetBytes <= regionBytes - blockBytes && tokenBytes <= regionBytes - blockBytes - offsetBytes;
}

__aicore__ inline bool ValidRegion(uint64_t base, uint64_t bytes, uint64_t stride0, uint64_t stride1,
                                  uint64_t blockSize, uint64_t tokenBytes)
{
    return base != 0 && bytes >= tokenBytes && base <= UINT64_MAX - bytes &&
           stride1 >= tokenBytes && stride0 / blockSize >= stride1;
}

__aicore__ inline GraphContextDetail CheckGraphContext(const GraphLaunchArgs &args, uint32_t core)
{
    const auto *ctx = reinterpret_cast<__gm__ const Context *>(args.copy.context);
    if (args.copy.channels == 0 || args.copy.channels > kMaxGraphChannels || core >= args.copy.channels ||
        ctx->magic != kMagic || ctx->version != kVersion ||
        ctx->bytes != sizeof(Context) + args.copy.channels * sizeof(uint64_t) ||
        ctx->generation == 0 || ctx->channels != args.copy.channels || ctx->batch != 32) {
        return kContextHeader;
    }
    if (ctx->blockSize == 0 || (ctx->blockSize & (ctx->blockSize - 1)) != 0 ||
        (ctx->elementBytes != 1 && ctx->elementBytes != 2) || ctx->kvDim == 0 || ctx->kvDim > 1024 ||
        ctx->ropeDim > 64 || ctx->hasRope != (ctx->ropeDim != 0)) {
        return kContextLayout;
    }
    if (ctx->localKv != args.localKv) return kContextKvAddress;
    if (ctx->localKvBytes != args.localKvBytes) return kContextKvBytes;
    if ((ctx->hasRope && (ctx->localRope != args.localRope || ctx->localRopeBytes != args.localRopeBytes)) ||
        (!ctx->hasRope && args.localRopeBytes != 0)) {
        return kContextRope;
    }

    const auto kvBytes = ctx->kvDim * ctx->elementBytes;
    const auto ropeBytes = ctx->ropeDim * ctx->elementBytes;
    if (ctx->localKvBytes / kvBytes != args.selectionSlots ||
        (ctx->hasRope && ctx->localRopeBytes / ropeBytes != args.selectionSlots)) {
        return kContextLocalSlots;
    }
    if (!ValidRegion(ctx->remoteKv, ctx->remoteKvBytes, ctx->kvStride0, ctx->kvStride1, ctx->blockSize, kvBytes) ||
        (ctx->hasRope && !ValidRegion(ctx->remoteRope, ctx->remoteRopeBytes, ctx->ropeStride0, ctx->ropeStride1,
                                    ctx->blockSize, ropeBytes))) {
        return kContextRemoteRegion;
    }
    return kContextValid;
}

__aicore__ inline uint64_t ValidateGraphCopy(GraphLaunchArgs &args, uint32_t core = 0,
                                            GraphContextDetail *contextDetail = nullptr)
{
    const auto detail = CheckGraphContext(args, core);
    if (contextDetail != nullptr) *contextDetail = detail;
    if (detail != kContextValid) return kBadContext;

    const auto *ctx = reinterpret_cast<__gm__ const Context *>(args.copy.context);
    const auto kvBytes = ctx->kvDim * ctx->elementBytes;
    const auto ropeBytes = ctx->ropeDim * ctx->elementBytes;
    const auto *q = reinterpret_cast<__gm__ const int32_t *>(args.q);
    int32_t previous = 0;
    for (uint64_t i = 0; i < args.qLength; ++i) {
        const int32_t length = q[i];
        if (length < previous) return kBadMapping;
        previous = length;
    }
    if (args.heads == 0 || static_cast<uint64_t>(previous) > args.groupsCapacity / args.heads) return kBadMapping;
    args.copy.groups = static_cast<uint64_t>(previous) * args.heads;
    const auto *counts = reinterpret_cast<__gm__ const int32_t *>(args.copy.counts);
    const auto *mapping = reinterpret_cast<__gm__ const int32_t *>(args.copy.mapping);
    // All blocks validate the same full mapping before submitting their own
    // shard. Private bitmaps preserve global duplicate detection without a
    // cross-block barrier or a per-replay reset kernel.
    auto *seen = reinterpret_cast<__gm__ uint32_t *>(args.seen) + core * args.seenStrideWords;
    const uint64_t checkedSlots = args.write ? args.remoteSlots : args.selectionSlots;
    for (uint64_t i = 0; i < (checkedSlots + 31) / 32; ++i) seen[i] = 0;

    uint64_t total = 0;
    for (uint64_t group = 0; group < args.copy.groups; ++group) {
        const int32_t count = counts[group];
        if (count < 0 || static_cast<uint64_t>(count) > args.copy.entries) return kBadMapping;
        for (int32_t index = 0; index < count; ++index) {
            const uint64_t entry = (group * args.copy.entries + index) * 2;
            const int32_t src = mapping[entry], dst = mapping[entry + 1];
            if (src < 0 || dst < 0 || static_cast<uint64_t>(dst) >= args.selectionSlots ||
                (args.write && static_cast<uint64_t>(src) >= args.remoteSlots) ||
                !TokenFits(src, ctx->blockSize, ctx->kvStride0, ctx->kvStride1, ctx->remoteKvBytes, kvBytes) ||
                (ctx->hasRope && !TokenFits(src, ctx->blockSize, ctx->ropeStride0, ctx->ropeStride1,
                                          ctx->remoteRopeBytes, ropeBytes))) {
                return kBadMapping;
            }
            const uint32_t destination = args.write ? src : dst;
            const uint32_t mask = 1U << (destination % 32);
            const uint32_t used = seen[destination / 32];
            if (used & mask) return kBadMapping;
            seen[destination / 32] = used | mask;
        }
        total += count;
    }
    args.copy.total = total;
    return 0;
}

__aicore__ inline bool WriteCompleted(const __gm__ volatile uint64_t *rows, uint64_t channels)
{
    for (uint64_t jetty = 0; jetty < channels; ++jetty) {
        const auto *status = rows + jetty * kStatusBytes / sizeof(uint64_t);
        if (status[0] != 0 || status[1] != kComplete) return false;
    }
    return true;
}

#ifndef AVSG_URMA_CPU_TEST
extern "C" __global__ __vector__ void AvsgCopyUrmaKernel(GraphLaunchArgs args)
{
    using namespace hixl::aiv::op::simt;
    const uint32_t core = AscendC::GetBlockIdx();
    GraphContextDetail contextDetail = kContextValid;
    uint64_t code = ValidateGraphCopy(args, core, &contextDetail);
    uint64_t phase = code ? kValidate : kComplete;
    if (code == 0 && args.writeStatus != 0) {
        HixlAivSimtUbCleanInvalidate(reinterpret_cast<__gm__ uint8_t *>(args.writeStatus),
                                   static_cast<uint32_t>(args.copy.channels * kStatusBytes));
        if (!WriteCompleted(reinterpret_cast<__gm__ const volatile uint64_t *>(args.writeStatus), args.copy.channels)) {
            code = kBadQueue;
            phase = kValidate;
        }
    }
    const TokenRange range = code == 0 && args.copy.total != 0
        ? BuildDescriptors(args.copy, core, false, args.write) : TokenRange{};
    if (range.count != 0) {
        const auto *ctx = reinterpret_cast<__gm__ const Context *>(args.copy.context);
        const uint64_t perToken = ctx->hasRope ? 2 : 1;
        LaunchArgs shard = args.copy;
        shard.scratch += range.first * perToken * sizeof(HixlDevXferDesc);
        shard.total = range.count;
        shard.channels = 1;
        HixlAivOpParam param{};
        // HIXL sees a one-entry channel table and a list local to this block.
        param.channel = args.copy.context + sizeof(Context) + core * sizeof(uint64_t);
        param.op_desc_list_addr = shard.scratch;
        param.list_num = static_cast<uint32_t>(range.count * perToken);
        param.mem_type = HIXL_AIV_MEM_TYPE_URMA;
        param.is_get = !args.write;
        param.reserved[2] = 1;
        param.reserved[5] = 32;
        {
            HixlAivSimtUbSession transfer;
            code = transfer.Start(param, 0, 0);
            while (code == hixl::aiv::HIXL_DEV_OK) {
                const auto state = transfer.RoundState();
                if (state == HIXL_AIV_SIMT_UBMICRO_ROUND_DONE) break;
                if (state != HIXL_AIV_SIMT_UBMICRO_ROUND_READY) {
                    code = transfer.ReclaimOverLimit() ? hixl::aiv::HIXL_DEV_BUSY :
                           transfer.Reclaim(transfer.ReclaimNeedCqe());
                    continue;
                }
                code = transfer.PrepareRound();
                if (code != hixl::aiv::HIXL_DEV_OK) break;
                asc_vf_call<HixlAivSimtFillWqeUbVf<32U>>(
                    dim3(32U), transfer.UbStage(), transfer.ubDescU32, transfer.ubTokenU32,
                    transfer.active, transfer.curHead, transfer.opcode, transfer.sqDepth,
                    transfer.tpId, transfer.rmtEidL, transfer.rmtEidH,
                    transfer.tokenUniform ? 1U : 0U, transfer.roundTokenId, transfer.roundTokenValue);
                code = transfer.Publish();
                transfer.Advance();
            }
            if (code != 0) phase = kSubmit;
            if (transfer.started) {
                const auto drain = transfer.Drain();
                if (code == 0 && drain != 0) {
                    phase = kDrain;
                    code = drain;
                }
            }
            transfer.Finish(static_cast<uint32_t>(code));
        }
        if (!args.write) {
            AscendC::Simt::VF_CALL<FinishDescriptors>(AscendC::Simt::Dim3{1, 1, 1}, shard, 0U);
            AscendC::PipeBarrier<PIPE_ALL>();
        }
    }
    AscendC::TPipe pipe;
    AscendC::TBuf<AscendC::TPosition::VECCALC> buffer;
    pipe.InitBuffer(buffer, kStatusBytes);
    Status(args.copy.status + core * kStatusBytes, code, phase, code == 0 ? range.count : 0,
           buffer.Get<uint32_t>(), contextDetail);
}

extern "C" void LaunchAvsgCopyUrma(void *stream, GraphLaunchArgs args)
{
    AvsgCopyUrmaKernel<<<static_cast<uint32_t>(args.copy.channels), 0, stream>>>(args);
}

extern "C" __global__ __vector__ void AvsgBuildDescriptorsKernel(LaunchArgs args)
{
    BuildDescriptors(args, AscendC::GetBlockIdx());
}

extern "C" __global__ __vector__ void AvsgFinishDescriptorsKernel(LaunchArgs args)
{
    AscendC::Simt::VF_CALL<FinishDescriptors>(AscendC::Simt::Dim3{1, 1, 1}, args, AscendC::GetBlockIdx());
}

extern "C" void LaunchAvsgBuildDescriptors(void *stream, LaunchArgs args)
{
    AvsgBuildDescriptorsKernel<<<static_cast<uint32_t>(args.channels), 0, stream>>>(args);
}

extern "C" void LaunchAvsgFinishDescriptors(void *stream, LaunchArgs args)
{
    AvsgFinishDescriptorsKernel<<<static_cast<uint32_t>(args.channels), 0, stream>>>(args);
}
#endif
} // namespace avsg_urma
