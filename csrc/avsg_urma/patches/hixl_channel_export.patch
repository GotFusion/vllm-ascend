+TEST_F(AivChannelManagerUTest, ExportAllChannelsAndInvalidateOnRemoval) {
+  const std::vector<uint64_t> input{kTestChannelPtrA, kTestChannelPtrB};
+  ASSERT_EQ(manager_->RegisterChannel(kRemoteEngineA, input[0], true, input), SUCCESS);
+  std::vector<uint64_t> output;
+  ASSERT_EQ(manager_->GetChannelPointers(kRemoteEngineA, output), SUCCESS);
+  EXPECT_EQ(output, input);
+  ASSERT_EQ(manager_->RemoveChannel(kRemoteEngineA), SUCCESS);
+  EXPECT_EQ(manager_->GetChannelPointers(kRemoteEngineA, output), NOT_CONNECTED);
+  EXPECT_TRUE(output.empty());
+}
+
+TEST_F(AivChannelManagerUTest, ExportRejectsUnhealthyAndDuplicateChannels) {
+  EXPECT_EQ(manager_->RegisterChannel(kRemoteEngineA, kTestChannelPtrA, true,
+                                      {kTestChannelPtrA, kTestChannelPtrA}), PARAM_INVALID);
+  ASSERT_EQ(manager_->RegisterChannel(kRemoteEngineA, kTestChannelPtrA, true,
+                                      {kTestChannelPtrA, kTestChannelPtrB}), SUCCESS);
+  ASSERT_EQ(manager_->ReportChannelError(kRemoteEngineA, 1U, 2U), SUCCESS);
+  std::vector<uint64_t> output{kTestChannelPtrA};
+  EXPECT_EQ(manager_->GetChannelPointers(kRemoteEngineA, output), FAILED);
+  EXPECT_TRUE(output.empty());
+}
