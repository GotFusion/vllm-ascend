+Status AivChannelManager::GetChannelPointers(const std::string &remote_engine,
+                                            std::vector<uint64_t> &channels) const {
+  std::lock_guard<std::mutex> lock(mutex_);
+  channels.clear();
+  auto it = channels_.find(remote_engine);
+  HIXL_CHK_BOOL_RET_STATUS(it != channels_.end(), NOT_CONNECTED,
+                           "No AIV channels for peer:%s", remote_engine.c_str());
+  HIXL_CHK_BOOL_RET_STATUS(it->second.healthy, FAILED,
+                           "AIV channels are unhealthy, peer:%s", remote_engine.c_str());
+  channels = it->second.channel_ptrs;
+  return SUCCESS;
+}
