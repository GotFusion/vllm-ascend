 * Adapted from ascend-kv-gather aiv/transfer.cpp at the pinned revision.
 * Keep the SDK vector multi-SGE WRITE builder and queue capacity checks;
 * replace the resident polling loop with one bounded, dynamically sized job.
 */
#include "hcomm/hcomm.h"
#include "kernel_operator.h"
#include "c_api/cache_ctrl/cache_ctrl.h"

#define KV_GATHER_AIV_DEVICE 1
#include "protocol.h"
#include "vector_builder.h"
#include "context.h"

namespace ascend_kv_gather {

__aicore__ inline void Flush(__gm__ void* base, std::uint32_t bytes)
{
    const auto address = reinterpret_cast<std::uint64_t>(base);
    const auto end = address + bytes;
    // Same cache-line coverage as the pinned source, including unaligned tails.
    for (auto line = address & ~std::uint64_t{127}; bytes != 0 && line < end; line += 64) {
        __asc_aicore::asc_dcci_single(reinterpret_cast<__gm__ void*>(line));
    }
}

class Gather {
public:
    __aicore__ inline void Init(GM_ADDR contexts, AscendC::TPipe& pipe)
    {
        context_ = reinterpret_cast<__gm__ TransferContext*>(contexts) + AscendC::GetBlockIdx();
        Flush(context_, sizeof(TransferContext));
        state_ = reinterpret_cast<__gm__ CoreState*>(context_->state);
        pipe.InitBuffer(wqe_buffer_, kv_gather_aiv::kBatchBufferBytes);
        pipe.InitBuffer(index_buffer_, kv_gather_aiv::kIndexScratchBytes);
        wqes_ = wqe_buffer_.Get<std::uint8_t>();
        indices_ = index_buffer_.Get<std::uint64_t>();
    }

    __aicore__ inline void Run()
    {
        const auto range = kv_gather_aiv::Partition(context_->rows, kSges, context_->cores, context_->core);
        if (range.count == 0) {
            Complete(0);
            return;
        }
        // MultiChannelHandle is not a raw ChannelHandle. Resolve the SDK's
        // underlying channel, lock it, then rebuild to refresh its GM cursors.
        const auto initial = hcomm_.MakeBatchHandle(
            static_cast<AscendC::MultiChannelHandle>(context_->channel), wqes_, kv_gather_aiv::kBatchBufferBytes);
        const auto channel = initial.channelHandle;
        const auto lock_status = hcomm_.Lock(channel);
        if (lock_status != AscendC::HCOMM_SUCCESS) {
            Complete(lock_status);
            return;
        }
        auto batch = hcomm_.MakeBatchHandle(
            static_cast<AscendC::MultiChannelHandle>(context_->channel), wqes_, kv_gather_aiv::kBatchBufferBytes);
        auto& peer = hcomm_.GetHandleRef(batch, 0U, reinterpret_cast<GM_ADDR>(context_->destination));
        Flush(reinterpret_cast<__gm__ void*>(context_->indices + std::uint64_t{range.first} * 8), range.count * 8);
        auto error = WriteRequest(batch, peer, range);
        if (error != AscendC::HCOMM_SUCCESS) {
            // A prior batch may have been submitted before a later one failed.
            // Attempt to drain it, but preserve the original failure status.
            (void)hcomm_.Drain(batch);
        }
        // Unlock writes SQ/CQ cursors through to the SDK ChannelEntity before
        // releasing its lock. Reconstructing a handle on the next launch is safe.
        const auto unlock_status = hcomm_.Unlock(channel);
        if (error == AscendC::HCOMM_SUCCESS) error = unlock_status;
        Complete(error);
    }

private:
    using Hcomm = AscendC::Hcomm<AscendC::COMM_PROTOCOL_UB_CTP>;

    __aicore__ inline void Complete(std::int32_t error)
    {
        state_->error = error;
        Flush(state_, sizeof(CoreState));
        state_->completed = context_->sequence;
        Flush(state_, 128);
    }

    __aicore__ inline int WriteRequest(AscendC::UbcMultiBatchHandle& batch, AscendC::UbcBatchHandle& peer,
                                       kv_gather_aiv::CoreRange range)
    {
        std::uint32_t offset = range.first;
        const auto end = range.first + range.count;
        std::uint32_t outstanding = 0;
        const auto sq_depth = peer.sqContext.contextInfo.ubJfs.sqDepth;
        const auto cq_depth = peer.cqContext.contextInfo.ubJfc.scqVa == 0 ? 0 : peer.cqContext.contextInfo.ubJfc.cqDepth;
        if (sq_depth < 2 || (sq_depth & (sq_depth - 1)) != 0 || cq_depth < 2) return -1;
        while (offset < end) {
            const auto plan = kv_gather_aiv::PlanBatch(end - offset, kSges, kBatchWqes);
            const auto sq_used = peer.cursor.sqHead - peer.cursor.sqTail;
            const auto cq_used = peer.cursor.cqHead - peer.cursor.cqTail;
            if (plan.queueBlocks > peer.buffer.bufferCapacity || sq_used >= sq_depth ||
                plan.queueBlocks >= sq_depth - sq_used || cq_used >= cq_depth || 1U >= cq_depth - cq_used) {
                return -1;
            }
            const auto build_status = BuildVector(peer, offset, plan);
            if (build_status != AscendC::HCOMM_SUCCESS) return build_status;
            const auto commit_status = hcomm_.BatchCommit(batch);
            if (commit_status != AscendC::HCOMM_SUCCESS) return commit_status;
            ++outstanding;
            offset += plan.indices;
            if (outstanding == kWindow || offset == end) {
                const auto drain_status = hcomm_.Drain(batch);
                if (drain_status != AscendC::HCOMM_SUCCESS) return drain_status;
                outstanding = 0;
            }
        }
        return AscendC::HCOMM_SUCCESS;
    }

    __aicore__ inline int BuildVector(AscendC::UbcBatchHandle& batch, std::uint32_t offset,
                                      const kv_gather_aiv::BatchPlan& plan)
    {
        const auto first_address = context_->indices + std::uint64_t{offset} * 8;
        const auto aligned_address = first_address & ~std::uint64_t{31};
        const auto prefix = static_cast<std::uint32_t>((first_address - aligned_address) / 8);
        const auto padded = (plan.indices + prefix + 3) & ~std::uint32_t{3};
        AscendC::GlobalTensor<std::uint64_t> source;
        source.SetGlobalBuffer(reinterpret_cast<__gm__ std::uint64_t*>(aligned_address), padded);
        AscendC::DataCopy(indices_, source, padded);
        AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
        auto* wqes = reinterpret_cast<__ubuf__ std::uint64_t*>(wqes_.GetPhyAddr());
        auto* indices = reinterpret_cast<__ubuf__ std::uint64_t*>(indices_.GetPhyAddr()) + prefix;
        const auto full_blocks = kv_gather_aiv::WqeBlocks(kSges);
        const auto previous = batch.cursor.preSqCnt;
        const auto head = batch.cursor.sqHead + previous;
        const auto local = context_->source;
        const auto bytes = context_->row_bytes;
        const auto remote = context_->destination + std::uint64_t{offset} * bytes;
        for (std::uint32_t first = 0; first < plan.uniformWqes; first += 32) {
            const auto remaining = plan.uniformWqes - first;
            const auto count = remaining < 32 ? remaining : 32;
            kv_gather_aiv::DispatchVectorWqes(wqes + (previous + first * full_blocks) * 8,
                indices + first * kSges, count, kSges, head + first * full_blocks,
                local, remote + std::uint64_t{first} * kSges * bytes, bytes,
                first + count == plan.wqes, batch, false);
        }
        if (plan.uniformWqes < plan.wqes) {
            const auto first = plan.uniformWqes;
            kv_gather_aiv::DispatchVectorWqes(wqes + (previous + first * full_blocks) * 8,
                indices + first * kSges, 1, plan.tailSges, head + first * full_blocks,
                local, remote + std::uint64_t{first} * kSges * bytes, bytes, true, batch, false);
        }
        AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
        batch.cursor.preSqCnt = previous + plan.queueBlocks;
        batch.cursor.cqHead += 1;
        return AscendC::HCOMM_SUCCESS;
    }

    Hcomm hcomm_;
    __gm__ TransferContext* context_;
    __gm__ CoreState* state_;
    AscendC::TBuf<AscendC::TPosition::VECOUT> wqe_buffer_;
    AscendC::TBuf<AscendC::TPosition::VECIN> index_buffer_;
    AscendC::LocalTensor<std::uint8_t> wqes_;
    AscendC::LocalTensor<std::uint64_t> indices_;
};
}  // namespace ascend_kv_gather

extern "C" __vector__ __global__ __aicore__ void AscendKvGatherKernel(GM_ADDR contexts)
{
    AscendC::TPipe pipe;
    ascend_kv_gather::Gather gather;
    gather.Init(contexts, pipe);
    gather.Run();
}
