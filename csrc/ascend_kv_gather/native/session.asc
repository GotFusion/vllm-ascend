extern "C" __vector__ __global__ __aicore__ void AscendKvGatherKernel(GM_ADDR contexts);

namespace {
using namespace ascend_kv_gather;

void Check(std::int64_t status, const char* operation)
{
    if (status != 0) {
        throw std::runtime_error(std::string(operation) + " rc=" + std::to_string(status));
    }
}

void Require(bool valid, const char* message)
{
    if (!valid) throw std::invalid_argument(message);
}

void Error(char* output, std::size_t capacity, const char* text) noexcept
{
    if (output == nullptr || capacity == 0) return;
    const auto length = std::min(capacity - 1, std::strlen(text));
    std::memcpy(output, text, length);
    output[length] = '\0';
}

template <typename Function>
int Guard(Function&& function, char* error, std::size_t capacity) noexcept
{
    Error(error, capacity, "");
    try {
        function();
        return 0;
    } catch (const std::exception& exception) {
        Error(error, capacity, exception.what());
    } catch (...) {
        Error(error, capacity, "unknown native ascend-kv-gather exception");
    }
    return -1;
}

struct Session {
    std::uint32_t rank = 0;
    std::uint32_t cores = 0;
    std::int32_t device = -1;
    std::uint64_t sequence = 0;
    bool poisoned = false;
    bool pending = false;
    HcclComm comm = nullptr;
    aclrtStream stream = nullptr;
    void* indices = nullptr;
    void* contexts = nullptr;
    void* states = nullptr;
    std::vector<Region> regions;
    std::vector<HcclMemHandle> registrations;
    std::vector<MultiChannelHandle> channels;
    std::mutex mutex;

    void CheckDevice() const
    {
        std::int32_t current = -1;
        Check(aclrtGetDevice(&current), "aclrtGetDevice");
        Require(current == device, "native session used on a different current device");
    }

    // If stream synchronization fails, keep all resources live: a timed-out
    // kernel must never access freed workspaces. The worker must terminate on
    // this fatal error. The same applies to a failed communicator teardown.
    void Close()
    {
        CheckDevice();
        if (pending && stream != nullptr) {
            Check(aclrtSynchronizeStreamWithTimeout(stream, kStreamTimeoutMs), "close stream drain");
            pending = false;
        }
        if (comm != nullptr) {
            Check(HcclCommDestroy(comm), "HcclCommDestroy");
            comm = nullptr;
        }
        std::int64_t first_error = 0;
        for (void** pointer : {&states, &contexts, &indices}) {
            if (*pointer != nullptr) {
                const auto status = aclrtFree(*pointer);
                if (first_error == 0) first_error = status;
                if (status == 0) *pointer = nullptr;
            }
        }
        if (stream != nullptr) {
            const auto status = aclrtDestroyStream(stream);
            if (first_error == 0) first_error = status;
            if (status == 0) stream = nullptr;
        }
        Check(first_error, "free native transfer resources");
    }
};

void Initialize(Session& session, const HcclRootInfo& root, const std::uint64_t* bases,
                const std::uint64_t* sizes, std::uint32_t region_count)
{
    Check(aclrtGetDevice(&session.device), "aclrtGetDevice");
    HcclCommConfig config{};
    HcclCommConfigInit(&config);
    config.hcclWorldRankID = session.rank;
    Check(HcclCommInitRootInfoConfig(2, &root, session.rank, &config, &session.comm), "initialize gather communicator");
    session.registrations.resize(region_count, nullptr);
    for (std::uint32_t index = 0; index < region_count; ++index) {
        CommMem memory{};
        memory.type = COMM_MEM_TYPE_DEVICE;
        memory.addr = reinterpret_cast<void*>(bases[index]);
        memory.size = sizes[index];
        const auto tag = "kvg_bank_" + std::to_string(index);
        Check(HcclCommMemReg(session.comm, tag.c_str(), &memory, &session.registrations[index]), "register gather bank");
        session.regions.push_back({bases[index], sizes[index]});
    }

    CommLink link{};
    bool found = false;
    std::uint32_t* layers = nullptr;
    std::uint32_t layer_count = 0;
    Check(HcclRankGraphGetLayers(session.comm, &layers, &layer_count), "get topology layers");
    for (std::uint32_t layer = 0; layer < layer_count && !found; ++layer) {
        CommLink* links = nullptr;
        std::uint32_t count = 0;
        Check(HcclRankGraphGetLinks(session.comm, layers[layer], session.rank, 1 - session.rank,
                                   &links, &count), "get peer links");
        for (std::uint32_t index = 0; index < count && !found; ++index) {
            if (links[index].linkAttr.linkProtocol == COMM_PROTOCOL_UB_CTP) {
                link = links[index];
                found = true;
            }
        }
    }
    Require(found, "no UB_CTP link between the gather ranks");
    HcclChannelDesc descriptor{};
    Check(HcclChannelDescInit(&descriptor, 1), "initialize gather channel descriptor");
    descriptor.remoteRank = 1 - session.rank;
    descriptor.channelProtocol = COMM_PROTOCOL_UB_CTP;
    descriptor.localEndpoint = link.srcEndpointDesc;
    descriptor.remoteEndpoint = link.dstEndpointDesc;
    descriptor.memHandleNum = 1;
    session.channels.resize(region_count * session.cores);
    for (std::uint32_t bank = 0; bank < region_count; ++bank) {
        descriptor.memHandles = &session.registrations[bank];
        for (std::uint32_t core = 0; core < session.cores; ++core) {
            // The SDK uses remoteBuffers[0]'s token. Each bank therefore needs
            // its own channel, not a shared channel with two registrations.
            const auto tag = "kvg_bank_" + std::to_string(bank) + "_core_" + std::to_string(core);
            Check(MakeMultiChannelHandle(session.comm, tag.c_str(), &descriptor, 1,
                                         &session.channels[bank * session.cores + core]), "create per-bank gather channel");
        }
    }
    if (session.rank == 1) {
        Check(aclrtCreateStream(&session.stream), "create gather stream");
        // Extra rows cover the aligned 32-byte tail copied by the vector builder.
        Check(aclrtMalloc(&session.indices, (kMaxRows + 4) * sizeof(std::uint64_t), ACL_MEM_MALLOC_HUGE_FIRST), "allocate gather indices");
        Check(aclrtMalloc(&session.contexts, session.cores * sizeof(TransferContext), ACL_MEM_MALLOC_HUGE_FIRST), "allocate gather contexts");
        const auto state_bytes = region_count * session.cores * sizeof(CoreState);
        Check(aclrtMalloc(&session.states, state_bytes, ACL_MEM_MALLOC_HUGE_FIRST), "allocate gather states");
        Check(aclrtMemset(session.states, state_bytes, 0, state_bytes), "initialize gather states");
    }
}

void Transfer(Session& session, std::uint64_t source, std::uint64_t destination,
              std::uint32_t row_bytes, const std::uint64_t* indices, std::uint32_t count)
{
    session.CheckDevice();
    Require(session.rank == 1, "only the peer rank submits gather transfers");
    Require(!session.poisoned, "gather session failed; restart the worker");
    const auto bank = ValidateTransfer(session.regions.data(), session.regions.size(), source,
                                       destination, row_bytes, indices, count);
    const auto max = std::numeric_limits<std::uint64_t>::max();
    Require(session.sequence != max, "gather sequence exhausted");
    const auto sequence = ++session.sequence;
    // Host indices remain private until the synchronous copy finishes. The
    // caller has already synchronized writes to the source tensors.
    std::vector<std::uint64_t> padded(indices, indices + count);
    padded.resize((count + 3U) & ~std::uint32_t{3}, 0);
    Check(aclrtMemcpy(session.indices, (kMaxRows + 4) * sizeof(std::uint64_t), padded.data(),
                      padded.size() * sizeof(std::uint64_t), ACL_MEMCPY_HOST_TO_DEVICE), "copy gather indices");
    std::vector<TransferContext> contexts(session.cores);
    for (std::uint32_t core = 0; core < session.cores; ++core) {
        const auto channel_index = bank * session.cores + core;
        contexts[core] = {session.channels[channel_index], source, destination,
                          reinterpret_cast<std::uint64_t>(session.indices),
                          reinterpret_cast<std::uint64_t>(session.states) + channel_index * sizeof(CoreState),
                          sequence, count, row_bytes, session.cores, core};
    }
    Check(aclrtMemcpy(session.contexts, contexts.size() * sizeof(TransferContext), contexts.data(),
                      contexts.size() * sizeof(TransferContext), ACL_MEMCPY_HOST_TO_DEVICE), "copy gather contexts");
    session.pending = true;
    AscendKvGatherKernel<<<session.cores, nullptr, session.stream>>>(static_cast<std::uint8_t*>(session.contexts));
    Check(aclrtSynchronizeStreamWithTimeout(session.stream, kStreamTimeoutMs), "gather AIV stream completion");
    session.pending = false;
    std::vector<CoreState> states(session.cores);
    const auto state_base = static_cast<std::uint8_t*>(session.states) + bank * session.cores * sizeof(CoreState);
    Check(aclrtMemcpy(states.data(), states.size() * sizeof(CoreState), state_base,
                      states.size() * sizeof(CoreState), ACL_MEMCPY_DEVICE_TO_HOST), "read gather completion");
    for (const auto& state : states) {
        Require(state.completed == sequence, "gather AIV did not publish completion");
        Check(state.error, "gather AIV transfer");
    }
}
}  // namespace

extern "C" size_t kvg_root_info_size(void)
{
    return sizeof(HcclRootInfo);
}

extern "C" int kvg_root_info(void* data, size_t capacity, char* error, size_t error_capacity)
{
    return Guard([&] {
        Require(data != nullptr && capacity >= sizeof(HcclRootInfo), "root info buffer is too small");
        HcclRootInfo root{};
        Check(HcclGetRootInfo(&root), "HcclGetRootInfo");
        std::memcpy(data, &root, sizeof(root));
    }, error, error_capacity);
}

extern "C" int kvg_create(uint32_t rank, const void* root_info, const uint64_t* bases,
                            const uint64_t* sizes, uint32_t regions, uint32_t cores,
                            void** output, char* error, size_t error_capacity)
{
    if (output != nullptr) *output = nullptr;
    return Guard([&] {
        Require(output != nullptr && root_info != nullptr, "null gather session or root info");
        Require(rank < 2 && cores > 0 && cores <= kMaxCores, "gather requires two ranks and 1-8 AIV cores");
        Require(bases != nullptr && sizes != nullptr && regions == 2, "register exactly two KV/RoPE banks");
        for (std::uint32_t index = 0; index < regions; ++index) {
            Require(bases[index] != 0 && sizes[index] != 0 &&
                    bases[index] <= std::numeric_limits<std::uint64_t>::max() - sizes[index], "invalid registered region");
        }
        Require(bases[0] + sizes[0] <= bases[1] || bases[1] + sizes[1] <= bases[0],
                "KV and RoPE registered regions must be disjoint");
        auto session = std::make_unique<Session>();
        session->rank = rank;
        session->cores = cores;
        HcclRootInfo root{};
        std::memcpy(&root, root_info, sizeof(root));
        try {
            Initialize(*session, root, bases, sizes, regions);
        } catch (const std::exception& initial) {
            session->poisoned = true;
            const std::string initial_message(initial.what());
            try {
                session->Close();
            } catch (const std::exception& cleanup) {
                *output = session.release();
                throw std::runtime_error(initial_message + "; cleanup failed: " + cleanup.what() +
                                         "; retain the returned session and bank tensors");
            } catch (...) {
                *output = session.release();
                throw std::runtime_error(initial_message + "; unknown cleanup failure; retain the returned session and bank tensors");
            }
            throw;
        } catch (...) {
            session->poisoned = true;
            try { session->Close(); } catch (...) { *output = session.release(); }
            throw;
        }
        *output = session.release();
    }, error, error_capacity);
}

extern "C" int kvg_transfer(void* opaque, uint64_t source, uint64_t destination,
                              uint32_t row_bytes, const uint64_t* indices, uint32_t count,
                              char* error, size_t error_capacity)
{
    return Guard([&] {
        Require(opaque != nullptr, "null gather session");
        auto& session = *static_cast<Session*>(opaque);
        std::lock_guard<std::mutex> lock(session.mutex);
        try {
            Transfer(session, source, destination, row_bytes, indices, count);
        } catch (...) {
            session.poisoned = true;
            throw;
        }
    }, error, error_capacity);
}

extern "C" int kvg_destroy(void* opaque, char* error, size_t error_capacity)
{
    return Guard([&] {
        if (opaque == nullptr) return;
        auto* session = static_cast<Session*>(opaque);
        session->poisoned = true;
        session->Close();
        delete session;
    }, error, error_capacity);
}
