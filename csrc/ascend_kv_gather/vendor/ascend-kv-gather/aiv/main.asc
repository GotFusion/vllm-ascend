namespace {
using namespace kv_gather_aiv;

#define COMMAND_OFFSET(field) (offsetof(Mailbox, command) + offsetof(Command, field))
#define CONTROL_OFFSET(field) (offsetof(Mailbox, control) + offsetof(Control, field))

struct Options {
    std::string endpoint;
    std::string matchPlanPath;
    std::uint32_t matchLayers = 1;
    std::vector<std::uint32_t> blocks;
    std::uint32_t cores = 1;
    std::uint32_t requests = 2;
    std::uint32_t warmup = 0;
    std::uint32_t sges = 13;
    std::uint32_t batchWqes = 64;
    std::uint32_t window = 16;
    std::uint32_t idleSeconds = 0;
    std::uint32_t idleAfterFirst = 1;
    bool stopInflight = false;
    bool cqePerWqe = false;
    bool progress = false;
    bool recvScatter = false;
    bool profileSimt = false;
    bool indexRefreshSpecified = false;
    SimtIndexRefresh simtIndexRefresh = SimtIndexRefresh::Element;
    Builder builder = Builder::Vector;
};

void Check(std::int64_t code, const char* operation)
{
    if (code != 0) {
        throw std::runtime_error(std::string(operation) + " rc=" + std::to_string(code));
    }
}

void Require(bool condition, const char* message)
{
    if (!condition) {
        throw std::runtime_error(message);
    }
}

void HostStep(std::uint32_t rank, const char* step)
{
    const auto ns = std::chrono::duration_cast<std::chrono::nanoseconds>(
        std::chrono::steady_clock::now().time_since_epoch()).count();
    std::fprintf(stderr, "HOST host_ns=%lld pid=%ld rank=%u step=%s\n",
                 static_cast<long long>(ns), static_cast<long>(getpid()), rank, step);
    std::fflush(stderr);
}

struct Resources {
    std::uint32_t rank;
    HcclComm comm = nullptr;
    HcclMemHandle registration = nullptr;
    ChannelHandle controlChannel = 0;
    std::vector<MultiChannelHandle> transferChannels;
    ThreadHandle hostThread = 0;
    ThreadHandle hostThreadOnDevice = 0;
    ThreadHandle worker = 0;
    ThreadHandle workerOnHost = 0;
    aclrtStream launchStream = nullptr;
    aclrtStream transferStream = nullptr;
    aclrtStream observationStream = nullptr;
    aclrtBinHandle binary = nullptr;
    aclrtFuncHandle entry = nullptr;
    aclrtArgsHandle arguments = nullptr;
    void* data = nullptr;
    void* mailbox = nullptr;
    void* request = nullptr;
    void* context = nullptr;
    void* samples = nullptr;
    void* queueSamples = nullptr;
    void* profileSamples = nullptr;
    void* scatterSelection = nullptr;
#if defined(KV_RECV_SCATTER_MATCH)
    void* scatterRequests = nullptr;
#endif
    std::uint64_t remoteData = 0;
    CommLink link{};

    void Close()
    {
        // Called after both ranks have synchronized every persistent launch.
        // HCCL owns the channels/registered regions acquired through its comm.
        HostStep(rank, "close_comm_begin");
        Check(HcclCommDestroy(comm), "HcclCommDestroy");
        HostStep(rank, "close_comm_end");
        comm = nullptr;
        HostStep(rank, "unload_binary_begin");
        Check(aclrtBinaryUnLoad(binary), "aclrtBinaryUnLoad");
        HostStep(rank, "unload_binary_end");
        HostStep(rank, "free_buffers_begin");
        if (profileSamples != nullptr) Check(aclrtFree(profileSamples), "free SIMT profiles");
        if (queueSamples != nullptr) Check(aclrtFree(queueSamples), "free SIMT queue samples");
        if (scatterSelection != nullptr) Check(aclrtFree(scatterSelection), "free scatter selection");
#if defined(KV_RECV_SCATTER_MATCH)
        if (scatterRequests != nullptr) Check(aclrtFree(scatterRequests), "free scatter requests");
#endif
        for (auto pointer : {samples, context, request, mailbox, data}) {
            Check(aclrtFree(pointer), "aclrtFree");
        }
        HostStep(rank, "free_buffers_end");
        HostStep(rank, "destroy_streams_begin");
        for (auto stream : {launchStream, transferStream, observationStream}) {
            Check(aclrtDestroyStream(stream), "aclrtDestroyStream");
        }
        HostStep(rank, "destroy_streams_end");
        HostStep(rank, "reset_device_begin");
        Check(aclrtResetDevice(static_cast<int>(rank)), "aclrtResetDevice");
        HostStep(rank, "reset_device_end");
        HostStep(rank, "acl_finalize_begin");
        Check(aclFinalize(), "aclFinalize");
        HostStep(rank, "acl_finalize_end");
    }
};

void Sync(aclrtStream stream)
{
    Check(aclrtSynchronizeStreamWithTimeout(stream, 5000), "control stream synchronize");
}

template <typename T>
void WriteField(Resources& resources, std::size_t offset, T value)
{
    // Write exactly the field width. In particular stop and blocks are uint32_t.
    Check(aclrtMemcpyAsync(static_cast<std::uint8_t*>(resources.mailbox) + offset, sizeof(T),
                          &value, sizeof(T), ACL_MEMCPY_HOST_TO_DEVICE, resources.observationStream),
          "mailbox publish");
    Sync(resources.observationStream);
}

void DumpMailbox(const Resources& resources, const Mailbox& state, std::uint32_t core)
{
    const auto hostNs = std::chrono::duration_cast<std::chrono::nanoseconds>(
        std::chrono::steady_clock::now().time_since_epoch()).count();
    std::fprintf(stderr, "STATE host_ns=%lld rank=%u core=%u ctl_phase=%u ctl_error=%d seq=%llu accepted=%llu "
        "result_ready=%llu verify_done=%llu verify_ok=%u consumed=%llu slot_free=%llu "
        "cmd_id=%llu cmd_blocks=%u aiv_phase=%u aiv_request=%llu next_index=%u "
        "wqes=%u batches=%u drains=%u done=%llu aiv_error=%d bad_block=%u bad_byte=%u "
        "bad_kv=%u actual=%u expected=%u\n", static_cast<long long>(hostNs), resources.rank, core,
        state.control.phase, state.control.error, static_cast<unsigned long long>(state.control.seq),
        static_cast<unsigned long long>(state.control.accepted), static_cast<unsigned long long>(state.control.resultReady),
        static_cast<unsigned long long>(state.control.verifyDone), state.control.verifyOk,
        static_cast<unsigned long long>(state.control.consumed), static_cast<unsigned long long>(state.control.slotFree),
        static_cast<unsigned long long>(state.command.requestId), state.command.blocks, state.transfer.phase,
        static_cast<unsigned long long>(state.transfer.activeRequest), state.transfer.nextIndex,
        state.transfer.completedWqes, state.transfer.completedBatches, state.transfer.completedDrains,
        static_cast<unsigned long long>(state.transfer.done), state.transfer.error,
        state.control.firstBadBlock, state.control.firstBadByte, state.control.firstBadKv,
        state.control.firstBadActual, state.control.firstBadExpected);
}

Mailbox ReadMailbox(Resources& resources, std::uint32_t core = 0)
{
    Mailbox result{};
    Check(aclrtMemcpyAsync(&result, sizeof(result), static_cast<std::uint8_t*>(resources.mailbox) + core * sizeof(Mailbox), sizeof(result),
                          ACL_MEMCPY_DEVICE_TO_HOST, resources.observationStream), "mailbox observe");
    Sync(resources.observationStream);
    if (result.control.error != 0 || result.transfer.error != 0) DumpMailbox(resources, result, core);
    Check(result.control.error, "AICPU control");
    Check(result.transfer.error, "AIV transfer");
    return result;
}

template <typename Predicate>
Mailbox Wait(Resources& resources, Predicate predicate, std::uint64_t seconds, const char* label, std::uint32_t core = 0)
{
    const auto deadline = std::chrono::steady_clock::now() + std::chrono::seconds(seconds);
    while (std::chrono::steady_clock::now() < deadline) {
        auto state = ReadMailbox(resources, core);
        if (predicate(state)) {
            return state;
        }
    }
    DumpMailbox(resources, ReadMailbox(resources, core), core);
    throw std::runtime_error(std::string("timeout waiting for ") + label);
}

void Allocate(void** pointer, std::size_t size)
{
    Check(aclrtMalloc(pointer, size, ACL_MEM_MALLOC_HUGE_FIRST), "aclrtMalloc");
}

void Initialize(Resources& resources, examples::RankSyncContext& sync, std::size_t samples, std::uint32_t cores)
{
    HostStep(resources.rank, "acl_init_begin");
    Check(aclInit(nullptr), "aclInit");
    HostStep(resources.rank, "acl_init_end");
    std::uint32_t visibleDevices = 0;
    Check(aclrtGetDeviceCount(&visibleDevices), "aclrtGetDeviceCount");
    Require(visibleDevices >= 2, "two visible devices are required");
    HostStep(resources.rank, "set_device_begin");
    Check(aclrtSetDevice(static_cast<int>(resources.rank)), "aclrtSetDevice");
    HostStep(resources.rank, "set_device_end");
    std::printf("rank=%u soc=%s\n", resources.rank, aclrtGetSocName());
    Check(aclrtCreateStream(&resources.launchStream), "create AICPU launch stream");
    Check(aclrtCreateStream(&resources.transferStream), "create AIV launch stream");
    Check(aclrtCreateStream(&resources.observationStream), "create observation stream");
    HcclCommConfig config{};
    HcclCommConfigInit(&config);
    config.hcclWorldRankID = resources.rank;
    HostStep(resources.rank, "comm_init_begin");
    Check(examples::InitCommByRootInfoConfig(sync, &config, &resources.comm), "initialize HCCL");
    HostStep(resources.rank, "comm_init_end");
    Allocate(&resources.data, kAllocationBytes);
    Allocate(&resources.mailbox, cores * sizeof(Mailbox));
    Allocate(&resources.request, kRequestAllocationBytes);
    Allocate(&resources.context, cores * sizeof(TransferContext));
    Allocate(&resources.samples, samples * (cores + 1) * sizeof(TransferSample));
    Check(aclrtMemset(resources.mailbox, cores * sizeof(Mailbox), 0, cores * sizeof(Mailbox)), "initialize mailbox");
    Check(aclrtMemset(resources.request, kRequestAllocationBytes, 0, kRequestAllocationBytes), "initialize request");
    Check(aclrtMemset(resources.samples, samples * (cores + 1) * sizeof(TransferSample), 0,
                     samples * (cores + 1) * sizeof(TransferSample)), "initialize samples");
    std::vector<std::uint8_t> data(kAllocationBytes, kGuard);
    for (std::uint32_t block = 0; block < kMaxBlocks; ++block) {
        for (std::uint32_t byte = 0; byte < kBlockBytes; ++byte) {
            data[kDataOffset + std::uint64_t{block} * kBlockBytes + byte] =
                resources.rank == 1 ? BlockValue(block, byte) : kSentinel;
        }
    }
    Check(aclrtMemcpy(resources.data, data.size(), data.data(), data.size(), ACL_MEMCPY_HOST_TO_DEVICE),
          "initialize registered pool");
    CommMem memory{};
    memory.type = COMM_MEM_TYPE_DEVICE;
    memory.addr = resources.data;
    memory.size = kAllocationBytes;
    Check(HcclCommMemReg(resources.comm, "kv_gather_aiv_data", &memory, &resources.registration), "register pool");
    const auto local = reinterpret_cast<std::uint64_t>(resources.data);
    std::uint64_t addresses[2]{};
    Require(sync.Allgather(examples::kTagUserBase, &local, sizeof(local), addresses), "exchange buffer addresses");
    resources.remoteData = addresses[1 - resources.rank];
    Require(resources.remoteData != 0, "null remote address");

    std::uint32_t* layers = nullptr;
    std::uint32_t layerCount = 0;
    Check(HcclRankGraphGetLayers(resources.comm, &layers, &layerCount), "get topology layers");
    bool found = false;
    for (std::uint32_t layer = 0; layer < layerCount && !found; ++layer) {
        CommLink* links = nullptr;
        std::uint32_t count = 0;
        Check(HcclRankGraphGetLinks(resources.comm, layers[layer], resources.rank, 1 - resources.rank,
                                   &links, &count), "get UB_CTP link");
        for (std::uint32_t index = 0; index < count && !found; ++index) {
            if (links[index].linkAttr.linkProtocol == COMM_PROTOCOL_UB_CTP) {
                resources.link = links[index];
                found = true;
            }
        }
    }
    Require(found, "no UB_CTP link");
}

void CreateChannels(Resources& resources, const std::string& queueTag, std::uint32_t cores, bool rawSimtSgl)
{
    HcclChannelDesc descriptor{};
    Check(HcclChannelDescInit(&descriptor, 1), "initialize channel descriptor");
    descriptor.remoteRank = 1 - resources.rank;
    descriptor.channelProtocol = COMM_PROTOCOL_UB_CTP;
    descriptor.localEndpoint = resources.link.srcEndpointDesc;
    descriptor.remoteEndpoint = resources.link.dstEndpointDesc;
    descriptor.memHandles = &resources.registration;
    descriptor.memHandleNum = 1;
    resources.transferChannels.resize(cores);
    for (std::uint32_t core = 0; core < cores; ++core) {
        if (rawSimtSgl) {
            ChannelHandle raw = 0;
            Check(HcclChannelAcquire(resources.comm, COMM_ENGINE_AIV, &descriptor, 1, &raw),
                  "create raw SIMT SGL channel");
            resources.transferChannels[core] = static_cast<MultiChannelHandle>(raw);
        } else {
            const auto tag = queueTag + "_core_" + std::to_string(core);
            Check(MakeMultiChannelHandle(resources.comm, tag.c_str(), &descriptor, 1,
                                        &resources.transferChannels[core]), "create per-core AIV channel");
        }
    }
    descriptor.memHandles = nullptr;
    descriptor.memHandleNum = 0;
    descriptor.notifyNum = 8;
    Check(HcclChannelAcquire(resources.comm, COMM_ENGINE_AICPU_TS, &descriptor, 1, &resources.controlChannel),
          "create AICPU channel");
    Check(HcclThreadAcquireWithStream(resources.comm, COMM_ENGINE_CPU_TS, resources.launchStream,
                                     1, &resources.hostThread), "bind launch thread");
    Check(HcclThreadExportToCommEngine(resources.comm, 1, &resources.hostThread, COMM_ENGINE_AICPU_TS,
                                      &resources.hostThreadOnDevice), "export launch thread");
    Check(HcclThreadAcquire(resources.comm, COMM_ENGINE_AICPU_TS, 1, 1, &resources.worker), "acquire worker");
    Check(HcclThreadExportToCommEngine(resources.comm, 1, &resources.worker, COMM_ENGINE_CPU_TS,
                                      &resources.workerOnHost), "export worker");
}

void Launch(Resources& resources, const Options& options)
{
    const char* sdk = std::getenv("ASCEND_HOME_PATH");
    Require(sdk != nullptr, "source the target CANN set_env.sh");
    const auto json = std::string(sdk) +
        "/opp/vendors/" KV_RECV_SCATTER_VENDOR "/aicpu/config/lib" KV_RECV_SCATTER_VENDOR "_control.json";
    aclrtBinaryLoadOption option{};
    option.type = ACL_RT_BINARY_LOAD_OPT_CPU_KERNEL_MODE;
    option.value.cpuKernelMode = 0;
    aclrtBinaryLoadOptions loadOptions{};
    loadOptions.numOpt = 1;
    loadOptions.options = &option;
    Check(aclrtBinaryLoadFromFile(json.c_str(), &loadOptions, &resources.binary), "load AICPU JSON");
    Check(aclrtBinaryGetFunction(resources.binary, KV_RECV_SCATTER_STRINGIFY(KV_RECV_SCATTER_CONTROL_ENTRY),
                                &resources.entry), "resolve entry");
    ControlArgs args{};
    Check(HcclGetCommName(resources.comm, args.commName), "get comm name");
    args.worker = resources.worker;
    args.channel = resources.controlChannel;
    args.localBuffer = static_cast<std::uint8_t*>(resources.data);
    args.scatterSelection = static_cast<std::uint8_t*>(resources.scatterSelection);
#if defined(KV_RECV_SCATTER_MATCH)
    args.scatterRequests = static_cast<const ScatterRequest*>(resources.scatterRequests);
#endif
    void* localCcl = nullptr;
    void* remoteCcl = nullptr;
    std::uint64_t localBytes = 0;
    std::uint64_t remoteBytes = 0;
    Check(HcclGetHcclBuffer(resources.comm, &localCcl, &localBytes), "get local CCL");
    Check(HcclChannelGetHcclBuffer(resources.comm, resources.controlChannel, &remoteCcl, &remoteBytes), "get remote CCL");
    Require(localBytes >= kRequestAllocationBytes && remoteBytes >= kRequestAllocationBytes, "CCL capacity");
    args.localCcl = static_cast<std::uint8_t*>(localCcl);
    args.remoteCcl = static_cast<std::uint8_t*>(remoteCcl);
    args.requestBuffer = static_cast<std::uint64_t*>(resources.request);
    args.mailbox = static_cast<Mailbox*>(resources.mailbox);
    args.samples = static_cast<TransferSample*>(resources.samples);
    args.sampleCapacity = static_cast<std::uint32_t>(options.blocks.size());
    args.rank = resources.rank;
    args.cores = options.cores;
    args.debugProgress = options.progress;
    aclrtParamHandle parameter = nullptr;
    Check(aclrtKernelArgsInit(resources.entry, &resources.arguments), "initialize kernel arguments");
    Check(aclrtKernelArgsAppend(resources.arguments, &args, sizeof(args), &parameter), "append kernel arguments");
    Check(aclrtKernelArgsFinalize(resources.arguments), "finalize kernel arguments");
    if (resources.rank == 1) {
        if (options.builder == Builder::SimtSgl) {
            Allocate(&resources.queueSamples, options.blocks.size() * sizeof(SimtQueueSample));
            Check(aclrtMemset(resources.queueSamples, options.blocks.size() * sizeof(SimtQueueSample), 0,
                              options.blocks.size() * sizeof(SimtQueueSample)), "initialize queue samples");
        }
        if (options.profileSimt) {
            const auto bytes = options.blocks.size() * sizeof(SimtProfileSample);
            Allocate(&resources.profileSamples, bytes);
            Check(aclrtMemset(resources.profileSamples, bytes, 0, bytes), "initialize SIMT profiles");
        }
        std::vector<TransferContext> contexts(options.cores);
        for (std::uint32_t core = 0; core < options.cores; ++core) {
            auto& context = contexts[core];
            context.channel = resources.transferChannels[core];
            context.localBuffer = reinterpret_cast<std::uint64_t>(resources.data);
            context.remoteBuffer = resources.remoteData;
            context.mailbox = reinterpret_cast<std::uint64_t>(resources.mailbox) + core * sizeof(Mailbox);
            context.requestBuffer = reinterpret_cast<std::uint64_t>(resources.request);
            context.builder = options.builder;
            context.sges = options.sges;
            context.batchWqes = options.batchWqes;
            context.window = options.window;
            context.cores = options.cores;
            context.core = core;
            context.cqePerWqe = options.cqePerWqe;
            context.queueSamples = reinterpret_cast<std::uint64_t>(resources.queueSamples);
            context.sampleCapacity = static_cast<std::uint32_t>(options.blocks.size());
            context.debugProgress = options.progress;
            context.profileSimt = options.profileSimt;
            context.simtIndexRefresh = options.simtIndexRefresh;
            Require(options.simtIndexRefresh != SimtIndexRefresh::Line128 || (context.requestBuffer & 127U) == 0,
                    "line128 requires a 128B-aligned request allocation");
            context.profileSamples = reinterpret_cast<std::uint64_t>(resources.profileSamples);
        }
        const auto contextBytes = contexts.size() * sizeof(TransferContext);
        Check(aclrtMemcpy(resources.context, contextBytes, contexts.data(), contextBytes, ACL_MEMCPY_HOST_TO_DEVICE),
              "copy transfer context");
        // Match the C25B046 launch boundary: pass a Host-side byte pointer and
        // let ASC marshal it to the kernel's GM_ADDR parameter.
        if (options.builder == Builder::SimtSgl) {
#if defined(KV_GATHER_ENABLE_SIMT_SGL)
            KvGatherSimtSglTransferKernel<<<1U, nullptr, resources.transferStream>>>(
                static_cast<std::uint8_t*>(resources.context));
#else
            throw std::runtime_error("SIMT SGL backend was not built");
#endif
        } else {
#if !defined(KV_GATHER_SIMT_SGL_ONLY)
            KvGatherAivTransferKernel<<<options.cores, nullptr, resources.transferStream>>>(
                static_cast<std::uint8_t*>(resources.context));
#else
            throw std::runtime_error("The fork executable only supports --builder simt-sgl");
#endif
        }
        std::printf("rank=1 launch_once=AIV cores=%u\n", options.cores);
        std::vector<Mailbox> states;
        for (std::uint32_t core = 0; core < options.cores; ++core) {
            auto state = Wait(resources, [](const Mailbox& value) { return value.transfer.ready == 1; },
                              30, "AIV READY", core);
            Require(state.transfer.sqAddress != 0 && state.transfer.cqAddress != 0, "null per-core queue");
            if (options.progress) Require(state.transfer.phase != 0, "missing AIV progress stamp");
            for (const auto& prior : states) {
                Require(prior.transfer.sqAddress != state.transfer.sqAddress &&
                        prior.transfer.cqAddress != state.transfer.cqAddress, "AIV cores share SQ or CQ");
            }
            std::printf("core=%u sq=0x%llx cq=0x%llx sq_depth=%u cq_depth=%u\n", core,
                static_cast<unsigned long long>(state.transfer.sqAddress),
                static_cast<unsigned long long>(state.transfer.cqAddress),
                state.transfer.sqDepth, state.transfer.cqDepth);
            states.push_back(state);
        }
    }
    Check(HcommThreadNotifyRecordOnThread(resources.hostThread, resources.workerOnHost, 0), "record local start");
    aclrtLaunchKernelAttr attribute{};
    attribute.id = ACL_RT_LAUNCH_KERNEL_ATTR_TIMEOUT;
    attribute.value.timeout = kServiceWaitSeconds;
    aclrtLaunchKernelCfg configuration{};
    configuration.attrs = &attribute;
    configuration.numAttrs = 1;
    Check(aclrtLaunchKernelWithConfig(resources.entry, 1, resources.launchStream, &configuration,
                                     resources.arguments, nullptr), "launch AICPU");
    std::printf("rank=%u launch_once=AICPU\n", resources.rank);
    const auto ready = Wait(resources, [](const Mailbox& state) { return state.control.ready == 1; }, 30, "AICPU READY");
    if (options.progress) Require(ready.control.phase != 0, "missing AICPU progress stamp; check deployed kernel");
}

void VerifyGuards(Resources& resources, const std::vector<std::uint64_t>* payload = nullptr)
{
    std::vector<std::uint8_t> data(kAllocationBytes);
    Check(aclrtMemcpy(data.data(), data.size(), resources.data, data.size(), ACL_MEMCPY_DEVICE_TO_HOST), "read pool");
    Require(std::all_of(data.begin(), data.begin() + kDataOffset, [](auto byte) { return byte == kGuard; }),
            "leading guard mismatch");
    Require(std::all_of(data.end() - 128, data.end(), [](auto byte) { return byte == kGuard; }),
            "trailing guard mismatch");
    if (payload != nullptr) {
        const auto blocks = (*payload)[1];
        for (std::uint32_t index = 0; index < blocks; ++index) {
            for (std::uint32_t byte = 0; byte < kBlockBytes; ++byte) {
                Require(data[kDataOffset + std::uint64_t{index} * kBlockBytes + byte] ==
                            BlockValue(static_cast<std::uint32_t>((*payload)[index + 2]), byte), "Host data mismatch");
            }
        }
        Require(std::all_of(data.begin() + kDataOffset + blocks * kBlockBytes, data.end() - 128,
                            [](auto byte) { return byte == kSentinel; }), "write beyond request");
    }
}

void VerifyScatterSelection(Resources& resources, std::vector<std::uint8_t>& expected,
                            const ScatterRequest& plan)
{
    for (std::uint32_t row = 0; row < plan.blocks; ++row) {
        const auto offset = ScatterSlotOffset(plan.destinations[row]);
        for (std::uint32_t byte = 0; byte < kBlockBytes; ++byte) {
            expected[offset + byte] = BlockValue(plan.sources[row], byte);
        }
    }
    std::vector<std::uint8_t> actual(expected.size());
    Check(aclrtMemcpy(actual.data(), actual.size(), resources.scatterSelection, actual.size(),
                      ACL_MEMCPY_DEVICE_TO_HOST), "read scatter selection");
    const auto mismatch = std::mismatch(expected.begin(), expected.end(), actual.begin());
    if (mismatch.first != expected.end()) {
        std::fprintf(stderr, "scatter_mismatch offset=%zu expected=%u actual=%u\n",
                     static_cast<std::size_t>(mismatch.first - expected.begin()),
                     static_cast<unsigned>(*mismatch.first), static_cast<unsigned>(*mismatch.second));
        throw std::runtime_error("scatter selection mismatch");
    }
}

double Median(std::vector<double> values)
{
    std::sort(values.begin(), values.end());
    const auto middle = values.size() / 2;
    return values.size() % 2 ? values[middle] : (values[middle - 1] + values[middle]) / 2;
}

void Produce(Resources& resources, const Options& options, const MatchScatterPlan& scatter)
{
    if constexpr (kBlockBytes == kPackedBlockBytes) {
        std::printf("packed_layout row_bytes=%u nope_offset=0 rope_offset=%u scale_offset=%u\n",
                    kBlockBytes, kPackedRopeOffset, kPackedScaleOffset);
    }
    std::vector<std::uint8_t> expected;
    if (options.recvScatter) {
        expected.assign(ScatterSelectionBytes(scatter.layers), kGuard);
        std::fill(expected.begin() + kDataOffset, expected.end() - 128, kSentinel);
#if defined(KV_RECV_SCATTER_MATCH)
        for (const auto& row : scatter.prefilled) {
            const auto offset = ScatterSlotOffset(row.destination);
            for (std::uint32_t byte = 0; byte < kBlockBytes; ++byte) {
                expected[offset + byte] = BlockValue(row.source, byte);
            }
        }
        std::printf("match_plan prefilled=%zu selection_slots=%u miss_counts=3,5 layers=%u requests=%zu\n",
                    scatter.prefilled.size(), kScatterSlots * scatter.layers, scatter.layers, scatter.requests.size());
#else
        std::fill_n(expected.begin() + ScatterSlotOffset(kScatterHitSlot), kBlockBytes, kScatterHitValue);
#endif
        Check(aclrtMemcpy(resources.scatterSelection, expected.size(), expected.data(), expected.size(),
                          ACL_MEMCPY_HOST_TO_DEVICE), "initialize scatter selection");
    }
    std::vector<std::uint64_t> indices(kMaxBlocks);
    std::iota(indices.begin(), indices.end(), 0);
    std::mt19937 random(0x5eed1234);
    std::shuffle(indices.begin(), indices.end(), random);
    std::vector<double> readyTimes;
    for (std::size_t request = 0; request < options.blocks.size(); ++request) {
        if (request == 0 || request == 1) {
            const auto idle = request == 0 ? options.idleSeconds : options.idleAfterFirst;
            std::printf("idle_seconds=%u\n", idle);
            std::this_thread::sleep_for(std::chrono::seconds(idle));
        }
        const auto blocks = options.blocks[request];
        const std::uint64_t seq = request + 1;
        // Online producer generates each list only after the previous slotFree.
        std::vector<std::uint64_t> payload(2 + blocks);
        payload[0] = seq;
        payload[1] = blocks;
        constexpr std::uint64_t small[3][3] = {{7, 2, 19}, {19, 7, 2}, {2, 19, 7}};
        if (options.recvScatter || kBlockBytes == kPackedBlockBytes) {
            std::copy_n(scatter.requests[request].sources, blocks, payload.begin() + 2);
        } else {
            for (std::uint32_t index = 0; index < blocks; ++index) {
                payload[index + 2] = blocks == 3 ? small[request % 3][index] :
                    indices[(index + request * 997) % indices.size()];
            }
        }
#if defined(KV_RECV_SCATTER_MATCH)
        std::printf("match_group_request seq=%llu step=%zu layer=%zu misses=%u\n",
                    static_cast<unsigned long long>(seq), request / scatter.layers + 1,
                    request % scatter.layers, blocks);
#endif
        Check(aclrtMemset(static_cast<std::uint8_t*>(resources.data) + kDataOffset,
                         kPayloadBytes, kSentinel, kPayloadBytes), "reset destination");
        Check(aclrtMemcpyAsync(resources.request, kRequestAllocationBytes, payload.data(), payload.size() * 8,
                              ACL_MEMCPY_HOST_TO_DEVICE, resources.observationStream), "publish payload");
        Sync(resources.observationStream);
        WriteField(resources, COMMAND_OFFSET(blocks), blocks);
        const auto published = std::chrono::steady_clock::now();
        WriteField(resources, CONTROL_OFFSET(seq), seq);
        std::printf("request_published seq=%llu blocks=%u\n", static_cast<unsigned long long>(seq), blocks);
        if (options.stopInflight) {
            const auto accepted = Wait(resources,
                [seq](const Mailbox& state) { return state.control.accepted == seq; }, 30, "accepted");
            Require(accepted.control.slotFree < seq, "request already completed before in-flight STOP observation");
            WriteField(resources, COMMAND_OFFSET(stop), std::uint32_t{1});
            std::printf("stop_published_inflight seq=%llu\n", static_cast<unsigned long long>(seq));
        }
        const auto readyState = Wait(resources, [seq](const Mailbox& state) {
            return state.control.resultReady == seq;
        }, 120, "resultReady");
        const auto observed = std::chrono::steady_clock::now();
        if (options.recvScatter) {
            Require(readyState.control.scatterDone == seq - 1 && readyState.control.consumed == seq - 1 &&
                    readyState.control.slotFree == seq - 1, "receive slot released before scatter");
            std::printf("scatter_held seq=%llu scatter_done=%llu consumed=%llu slot_free=%llu\n",
                        static_cast<unsigned long long>(seq),
                        static_cast<unsigned long long>(readyState.control.scatterDone),
                        static_cast<unsigned long long>(readyState.control.consumed),
                        static_cast<unsigned long long>(readyState.control.slotFree));
            if constexpr (kBlockBytes == kPackedBlockBytes) {
                for (std::uint32_t row = 0; row < blocks; ++row) {
                    const auto slot = scatter.requests[request].destinations[row];
                    const auto src = reinterpret_cast<std::uintptr_t>(resources.data) + ScatterSlotOffset(row);
                    const auto dst = reinterpret_cast<std::uintptr_t>(resources.scatterSelection) + ScatterSlotOffset(slot);
                    std::printf("scatter_address seq=%llu receive_row=%u dst_slot=%u src_mod64=%u dst_mod64=%u\n",
                                static_cast<unsigned long long>(seq), row, slot,
                                static_cast<unsigned>(src % 64U), static_cast<unsigned>(dst % 64U));
#if defined(KV_RECV_SCATTER_MATCH)
                    std::printf("match_pair_applied seq=%llu receive_row=%u src_slot=%u dst_slot=%u\n",
                                static_cast<unsigned long long>(seq), row, scatter.requests[request].sources[row], slot);
#endif
                }
            }
            WriteField(resources, COMMAND_OFFSET(scatterRelease), seq);
        }
        Wait(resources, [seq](const Mailbox& state) { return state.control.verifyDone == seq; }, 180, "verifyDone");
        auto final = Wait(resources, [seq](const Mailbox& state) { return state.control.slotFree == seq; }, 60, "slotFree");
        Require(final.control.verifyOk == 1 && final.control.consumed == seq, "consumer verification failed");
        Require(final.control.sendNs <= final.control.readyNs && final.control.readyNs <= final.control.verifyNs &&
                final.control.verifyNs <= final.control.freeNs, "completion timestamp order");
        VerifyGuards(resources, &payload);
        if (options.recvScatter) {
            Require(final.control.scatterDone == seq, "slotFree without completed scatter");
            VerifyScatterSelection(resources, expected, scatter.requests[request]);
            std::printf("scatter_verified seq=%llu scatter_done=%llu consumed=%llu slot_free=%llu "
                        "bytes=%u receive_exact=1 selection_exact=1 guards_exact=1\n",
                        static_cast<unsigned long long>(seq), static_cast<unsigned long long>(final.control.scatterDone),
                        static_cast<unsigned long long>(final.control.consumed),
                        static_cast<unsigned long long>(final.control.slotFree), blocks * kBlockBytes);
        }
        const auto ready = final.control.readyNs - final.control.sendNs;
        const auto verify = final.control.verifyNs - final.control.readyNs;
        const auto free = final.control.freeNs - final.control.verifyNs;
        const auto host = std::chrono::duration_cast<std::chrono::nanoseconds>(observed - published).count();
        const bool warmup = request < options.warmup;
        std::printf("a_sample seq=%llu warmup=%d blocks=%u ready_ns=%llu verify_ns=%llu free_ns=%llu "
                    "host_observe_ns=%lld payload_GBps=%.6f guards=ok verified=ok consumed=%llu slot_free=%llu\n",
                    static_cast<unsigned long long>(seq), warmup, blocks,
                    static_cast<unsigned long long>(ready), static_cast<unsigned long long>(verify),
                    static_cast<unsigned long long>(free), static_cast<long long>(host),
                    static_cast<double>(blocks) * kBlockBytes / ready,
                    static_cast<unsigned long long>(seq), static_cast<unsigned long long>(seq));
        if (!warmup) {
            readyTimes.push_back(static_cast<double>(ready));
        }
    }
    std::printf("a_summary samples=%zu median_ready_ns=%.1f\n", readyTimes.size(), Median(readyTimes));
    WriteField(resources, COMMAND_OFFSET(stop), std::uint32_t{1});
    std::printf("stop_published\n");
}

int RunRank(std::uint32_t rank, Options options, std::string session)
{
    Resources resources{};
    resources.rank = rank;
    try {
        MatchScatterPlan scatter;
#if defined(KV_RECV_SCATTER_MATCH)
        if (rank == 0) {
            std::ifstream input(options.matchPlanPath);
            Require(static_cast<bool>(input), "cannot open Match scatter plan");
            scatter = ReadMatchScatterPlan(input, options.matchLayers);
            Require(scatter.requests.size() == options.blocks.size(), "Match scatter schedule mismatch");
        }
#endif
        HostStep(rank, "control_socket_begin");
        auto sync = rank == 0 ? examples::RankSyncContext::Listen(options.endpoint, 2) :
                                examples::RankSyncContext::Connect(rank, 2, options.endpoint);
        Require(sync.Ok(), "control channel failed");
        HostStep(rank, "control_socket_end");
        Initialize(resources, sync, options.blocks.size(), options.cores);
        if (rank == 0 && options.recvScatter) {
            Allocate(&resources.scatterSelection, ScatterSelectionBytes(scatter.layers));
#if defined(KV_RECV_SCATTER_MATCH)
            const auto requestBytes = scatter.requests.size() * sizeof(ScatterRequest);
            Allocate(&resources.scatterRequests, requestBytes);
            Check(aclrtMemcpy(resources.scatterRequests, requestBytes, scatter.requests.data(), requestBytes,
                              ACL_MEMCPY_HOST_TO_DEVICE), "upload Match scatter requests");
#endif
        }
        HostStep(rank, "channels_begin");
        CreateChannels(resources, session + "_" + std::to_string(rank), options.cores,
                       options.builder == Builder::SimtSgl);
        HostStep(rank, "channels_end");
        HostStep(rank, "launch_service_begin");
        Launch(resources, options);
        HostStep(rank, "launch_service_end");
        Require(sync.Barrier(examples::kTagUserBase + 1), "both READY barrier failed");
        if (rank == 0) {
            std::printf("both_ready\n");
            Produce(resources, options, scatter);
        }
        const auto budget = std::uint64_t{options.idleSeconds} + options.idleAfterFirst +
                            options.blocks.size() * 30 + 300;
        Wait(resources, [](const Mailbox& state) { return state.control.stopped == 1; }, budget, "STOPPED");
        Check(aclrtSynchronizeStreamWithTimeout(resources.launchStream, 60000), "AICPU stream completion");
        if (rank == 1) {
            Check(aclrtSynchronizeStreamWithTimeout(resources.transferStream, 60000), "AIV stream completion");
            std::vector<TransferSample> samples(options.blocks.size() * (options.cores + 1));
            Check(aclrtMemcpy(samples.data(), samples.size() * sizeof(TransferSample), resources.samples,
                              samples.size() * sizeof(TransferSample), ACL_MEMCPY_DEVICE_TO_HOST), "read B samples");
            for (std::size_t request = 0; request < options.blocks.size(); ++request) {
                const auto base = request * (options.cores + 1);
                const auto& aggregate = samples[base + options.cores];
                Require(aggregate.requestId == request + 1 && aggregate.dataCycles > 0, "missing B group sample");
                std::printf("b_group_sample seq=%zu warmup=%d cores=%u dispatch_to_all_done_ns=%llu payload_GBps=%.6f\n",
                    request + 1, request < options.warmup, options.cores,
                    static_cast<unsigned long long>(aggregate.dataCycles),
                    static_cast<double>(options.blocks[request]) * kBlockBytes / aggregate.dataCycles);
                for (std::uint32_t core = 0; core < options.cores; ++core) {
                    const auto& sample = samples[base + core];
                    const auto range = Partition(options.blocks[request], options.sges, options.cores, core);
                    Require(sample.requestId == request + 1, "missing B core sample");
                    if (options.recvScatter || kBlockBytes == kPackedBlockBytes) {
                        Require(sample.wqes == 1 && sample.batches == 1 && sample.cqes == 1 && sample.drains == 1,
                                "unexpected scatter smoke WRITE counts");
                    }
                    std::printf("b_sample seq=%zu core=%u first=%u blocks=%u warmup=%d data_ns=%llu "
                                "index_dcci_ns=%llu construct_ns=%llu wqes=%u batches=%u cqes=%u drains=%u\n",
                        request + 1, core, range.first, range.count, request < options.warmup,
                        static_cast<unsigned long long>(sample.dataCycles),
                        static_cast<unsigned long long>(sample.indexDcciCycles),
                        static_cast<unsigned long long>(sample.constructCycles), sample.wqes,
                        sample.batches, sample.cqes, sample.drains);
                    const auto count = range.count;
                    const auto wqes = (count + options.sges - 1) / options.sges;
                    const auto tail = count % options.sges;
                    const auto expectedBbs = options.builder == Builder::SimtSgl ? 2 * wqes :
                        options.builder == Builder::Simt ? wqes + sample.batches :
                        (count / options.sges) * WqeBlocks(options.sges) + (tail ? WqeBlocks(tail) : 0U);
                    const auto expectedSges = options.builder == Builder::SimtSgl ?
                        count + (options.sges == 1 ? wqes : (tail == 1 ? 1U : 0U)) :
                        options.builder == Builder::Simt ? count + sample.batches : count;
                    std::printf("b_layout seq=%zu core=%u expected_queue_bbs=%u expected_sges=%u "
                                "submission_doorbells=%u cqe_per_wqe=%d\n",
                                request + 1, core, expectedBbs, expectedSges, sample.batches, options.cqePerWqe);
                }
            }
            if (options.builder == Builder::SimtSgl) {
                std::vector<SimtQueueSample> audits(options.blocks.size());
                Check(aclrtMemcpy(audits.data(), audits.size() * sizeof(SimtQueueSample), resources.queueSamples,
                                  audits.size() * sizeof(SimtQueueSample), ACL_MEMCPY_DEVICE_TO_HOST), "read queue audit");
                std::vector<SimtProfileSample> profiles;
                if (options.profileSimt) {
                    profiles.resize(options.blocks.size());
                    Check(aclrtMemcpy(profiles.data(), profiles.size() * sizeof(SimtProfileSample),
                                      resources.profileSamples, profiles.size() * sizeof(SimtProfileSample),
                                      ACL_MEMCPY_DEVICE_TO_HOST), "read SIMT profiles");
                }
                std::uint64_t totalWqes = 0;
                for (std::size_t request = 0; request < audits.size(); ++request) {
                    const auto& audit = audits[request];
                    const auto wqes = (options.blocks[request] + options.sges - 1) / options.sges;
                    const auto base = request * (options.cores + 1);
                    const auto& sample = samples[base];
                    Require(audit.requestId == request + 1 && audit.status == 0 && audit.wqeSize == 64,
                            "missing SIMT SGL queue audit");
                    Require(sample.wqes == wqes && sample.cqes == wqes &&
                            sample.batches == (wqes + options.batchWqes - 1) / options.batchWqes &&
                            sample.drains == (sample.batches + options.window - 1) / options.window, "SIMT SGL counts");
                    Require(audit.sqDepth > 0 && audit.cqDepth > 0 &&
                            static_cast<std::uint32_t>(audit.headAfter) - static_cast<std::uint32_t>(audit.headBefore) == 2 * wqes &&
                            static_cast<std::uint32_t>(audit.headAfter >> 32) - static_cast<std::uint32_t>(audit.headBefore >> 32) == wqes,
                            "SIMT SGL queue deltas");
                    Require(audit.sqTailBefore == static_cast<std::uint32_t>(audit.headBefore) &&
                            audit.cqTailBefore == static_cast<std::uint32_t>(audit.headBefore >> 32) &&
                            audit.sqTailAfter == static_cast<std::uint32_t>(audit.headAfter) &&
                            audit.cqTailAfter == static_cast<std::uint32_t>(audit.headAfter >> 32), "SIMT SGL queue not reclaimed");
                    if (request != 0) {
                        const auto& prior = audits[request - 1];
                        Require(audit.headBefore == prior.headAfter && audit.channel == prior.channel &&
                                audit.sqAddress == prior.sqAddress && audit.cqAddress == prior.cqAddress &&
                                audit.sqDepth == prior.sqDepth && audit.cqDepth == prior.cqDepth, "SIMT SGL queue changed");
                    }
                    std::printf("b_sgl_queue seq=%zu head_before=0x%llx head_after=0x%llx "
                                "sq_tail=%u cq_tail=%u sq_depth=%u cq_depth=%u reclaimed=1\n", request + 1,
                                static_cast<unsigned long long>(audit.headBefore), static_cast<unsigned long long>(audit.headAfter),
                                audit.sqTailAfter, audit.cqTailAfter, audit.sqDepth, audit.cqDepth);
                    if (options.profileSimt) {
                        const auto& profile = profiles[request];
                        const auto measured = profile.appendVfCycles + profile.appendStatusCycles +
                            profile.drainVfCycles + profile.drainStatusCycles + profile.auditCycles;
                        Require(profile.requestId == request + 1 && profile.appendCalls == sample.batches &&
                                profile.drainCalls == sample.drains && profile.auditCalls == 2 &&
                                profile.dataCycles == sample.dataCycles && profile.constructCycles == sample.constructCycles &&
                                measured <= profile.dataCycles && profile.appendVfCycles + profile.appendStatusCycles <=
                                profile.constructCycles, "SIMT profile inconsistent");
                        std::printf("b_simt_profile seq=%zu warmup=%d append_vf_ns=%llu append_status_ns=%llu "
                                    "drain_vf_ns=%llu drain_status_ns=%llu audit_ns=%llu other_ns=%llu "
                                    "append_calls=%u drain_calls=%u audit_calls=%u\n", request + 1,
                            request < options.warmup,
                            static_cast<unsigned long long>(profile.appendVfCycles),
                            static_cast<unsigned long long>(profile.appendStatusCycles),
                            static_cast<unsigned long long>(profile.drainVfCycles),
                            static_cast<unsigned long long>(profile.drainStatusCycles),
                            static_cast<unsigned long long>(profile.auditCycles),
                            static_cast<unsigned long long>(profile.dataCycles - measured),
                            profile.appendCalls, profile.drainCalls, profile.auditCalls);
                    }
                    totalWqes += wqes;
                }
                const auto& first = audits.front();
                const auto& last = audits.back();
                std::printf("b_sgl_summary requests=%zu wqes=%llu cqes=%llu queue_bbs=%llu sq_wraps=%u cq_wraps=%u "
                            "queue_recreated=0 queue_audit_in_data=1 lane_index_dcci_in_construct=1\n", audits.size(),
                            static_cast<unsigned long long>(totalWqes), static_cast<unsigned long long>(totalWqes),
                            static_cast<unsigned long long>(totalWqes * 2),
                            static_cast<std::uint32_t>(last.headAfter) / last.sqDepth -
                                static_cast<std::uint32_t>(first.headBefore) / first.sqDepth,
                            static_cast<std::uint32_t>(last.headAfter >> 32) / last.cqDepth -
                                static_cast<std::uint32_t>(first.headBefore >> 32) / first.cqDepth);
            }
            VerifyGuards(resources);
        }
        Require(sync.Barrier(examples::kTagUserBase + 2), "shutdown barrier failed");
        std::printf("rank=%u stopped streams_completed=1\n", rank);
        resources.Close();
        HostStep(rank, "rank_body_complete");
        return 0;
    } catch (const std::exception& error) {
        // A failed launch may still own its buffers. End the rank process without
        // running normal buffer destruction against active kernels.
        std::fprintf(stderr, "rank=%u FAIL %s\n", rank, error.what());
        std::fprintf(stderr, "worker_exit rank=%u pid=%ld status=1 boundary=RunRank_catch\n", rank, static_cast<long>(getpid()));
        std::fflush(stdout);
        std::fflush(stderr);
        _exit(1);
    }
}

Options Parse(int argc, char** argv)
{
    Require(argc >= 2, "usage: kv_gather_aiv|kv_gather_simt_sgl tcp://127.0.0.1:PORT [--blocks N|--blocks-list 3,20000,3] "
                       "[--aiv-cores N --requests N --warmup N --builder scalar|vector|simt|simt-sgl --sges N --batch-wqes N "
                       "--window N --idle-before N --idle-after-first N --stop-inflight --progress --profile-simt "
                       "--simt-index-refresh element|line128 --recv-scatter --match-plan FILE]");
    Options options;
#if defined(KV_GATHER_SIMT_SGL_ONLY)
    options.builder = Builder::SimtSgl;
    options.sges = 5;
    options.batchWqes = 32;
#endif
    options.endpoint = argv[1];
    Require(options.endpoint.rfind("tcp://", 0) == 0, "expected tcp://host:port endpoint");
    std::uint32_t blocks = 3;
    for (int index = 2; index < argc; ++index) {
        const std::string name = argv[index];
        if (name == "--recv-scatter") {
            options.recvScatter = true;
            continue;
        }
        if (name == "--profile-simt") {
            options.profileSimt = true;
            continue;
        }
        if (name == "--progress") {
            options.progress = true;
            continue;
        }
        if (name == "--cqe-per-wqe") {
            options.cqePerWqe = true;
            continue;
        }
        if (name == "--stop-inflight") {
            options.stopInflight = true;
            continue;
        }
        Require(index + 1 < argc, "option value missing");
        const std::string value = argv[++index];
        if (name == "--match-plan") {
            options.matchPlanPath = value;
        } else if (name == "--builder") {
            Require(value == "scalar" || value == "vector" || value == "simt" || value == "simt-sgl", "unknown builder");
            options.builder = value == "scalar" ? Builder::Scalar :
                              value == "vector" ? Builder::Vector :
                              value == "simt" ? Builder::Simt : Builder::SimtSgl;
        } else if (name == "--simt-index-refresh") {
            Require(value == "element" || value == "line128", "simt-index-refresh must be element or line128");
            options.indexRefreshSpecified = true;
            options.simtIndexRefresh = value == "line128" ? SimtIndexRefresh::Line128 : SimtIndexRefresh::Element;
        } else if (name == "--blocks-list") {
            std::size_t begin = 0;
            while (begin < value.size()) {
                const auto end = value.find(',', begin);
                std::uint32_t count = 0;
                Require(examples::ParseUint32(value.substr(begin, end - begin).c_str(), count, 1) && count <= kMaxBlocks,
                        "invalid blocks list");
                options.blocks.push_back(count);
                if (end == std::string::npos) {
                    break;
                }
                begin = end + 1;
                Require(begin < value.size(), "trailing comma in blocks list");
            }
            Require(!options.blocks.empty(), "empty blocks list");
        } else {
            std::uint32_t number = 0;
            Require(examples::ParseUint32(value.c_str(), number), "invalid integer");
            if (name == "--aiv-cores") {
                options.cores = number;
            } else if (name == "--blocks") {
                blocks = number;
            } else if (name == "--requests") {
                options.requests = number;
            } else if (name == "--warmup") {
                options.warmup = number;
            } else if (name == "--sges") {
                options.sges = number;
            } else if (name == "--batch-wqes") {
                options.batchWqes = number;
            } else if (name == "--window") {
                options.window = number;
            } else if (name == "--idle-before") {
                options.idleSeconds = number;
            } else if (name == "--idle-after-first") {
                options.idleAfterFirst = number;
            } else {
                throw std::runtime_error("unknown option " + name);
            }
        }
    }
    Require(options.cores >= 1 && options.cores <= kMaxCores, "aiv-cores must be 1..8");
#if defined(KV_GATHER_SIMT_SGL_ONLY)
    Require(options.builder == Builder::SimtSgl, "Use kv_gather_aiv for SDK scalar/vector modes");
#endif
    if (options.builder == Builder::Simt) {
#if !defined(KV_GATHER_ENABLE_SDK_SIMT)
        throw std::runtime_error("Experimental SDK SIMT is disabled in this build");
#endif
        Require(options.cores == 1 && options.sges == 1 && options.batchWqes <= 32,
                "first SIMT backend requires --aiv-cores 1 --sges 1 --batch-wqes 1..32");
        options.cqePerWqe = true;
    }
    if (options.builder == Builder::SimtSgl) {
#if !defined(KV_GATHER_ENABLE_SIMT_SGL)
        throw std::runtime_error("Use build_aiv/kv_gather_simt_sgl from the fixed-fork build");
#endif
        Require(ValidSimtSgl(options.cores, options.sges, options.batchWqes, options.window),
                "SIMT SGL requires --aiv-cores 1 --sges 1..5 --batch-wqes 1..32 --window 1..16");
        options.cqePerWqe = true;
    }
    Require(!options.indexRefreshSpecified || options.builder == Builder::SimtSgl,
            "--simt-index-refresh requires simt-sgl");
    Require(!options.profileSimt || (options.builder == Builder::SimtSgl && !options.progress),
            "--profile-simt requires simt-sgl without --progress");
    Require(options.requests > 0, "requests must be positive");
    if (options.blocks.empty()) {
        options.blocks.assign(options.requests, blocks);
    }
    Require(options.blocks.size() <= UINT32_MAX && options.warmup < options.blocks.size(), "invalid sample counts");
    for (auto count : options.blocks) {
        Require(ValidTransfer(count, options.sges, options.batchWqes, options.window), "transfer parameters out of range");
    }
    Require(options.idleSeconds < kServiceWaitSeconds && options.idleAfterFirst < kServiceWaitSeconds,
            "idle must be shorter than the 300-second request wait budget");
    Require(!options.stopInflight || options.blocks.size() == 1, "in-flight STOP test takes one request");
#if defined(KV_RECV_SCATTER_MATCH)
    Require(options.recvScatter && !options.matchPlanPath.empty(),
            "Match build requires --recv-scatter --match-plan FILE");
#else
    Require(options.matchPlanPath.empty(), "--match-plan requires the Match build");
#endif
    if (options.recvScatter || kBlockBytes == kPackedBlockBytes) {
        Require(options.builder == Builder::Vector && options.cores == 1 && options.sges == 5,
                "--recv-scatter and the packed build require --builder vector --aiv-cores 1 --sges 5");
        auto validSchedule = options.blocks == std::vector<std::uint32_t>{kScatterPlan[0].blocks, kScatterPlan[1].blocks};
#if defined(KV_RECV_SCATTER_MATCH)
        std::vector<std::uint32_t> groupSchedule;
        for (const auto& request : kScatterPlan) {
            groupSchedule.insert(groupSchedule.end(), kMatchGroupLayers, request.blocks);
        }
        if (options.blocks == groupSchedule) {
            options.matchLayers = kMatchGroupLayers;
            validSchedule = true;
        }
#endif
        Require(validSchedule,
                "expected --blocks-list 3,5 or, in the Match build, 3,3,3,3,5,5,5,5");
    }
    return options;
}
} // namespace

int main(int argc, char** argv)
{
    std::uint32_t rank = UINT32_MAX;
    try {
        Require(argc >= 7 && std::string(argv[1]) == "--rank-worker" &&
                examples::ParseUint32(argv[2], rank) && rank <= 1 &&
                std::string(argv[3]) == "--session" && std::string(argv[5]) == "--",
                "Launch through kv_gather_aiv or kv_gather_simt_sgl supervisor");
        HostStep(rank, "worker_main");
        const std::string session = argv[4];
        std::vector<char*> optionsArgv{argv[0]};
        for (int index = 6; index < argc; ++index) optionsArgv.push_back(argv[index]);
        const auto options = Parse(static_cast<int>(optionsArgv.size()), optionsArgv.data());
#if defined(KV_GATHER_SIMT_SGL_ONLY)
        std::printf("binary_backend=fork-simt-sgl progress=%d\n", options.progress);
#else
        std::printf("binary_backend=sdk progress=%d\n", options.progress);
#endif
        std::printf("engine=AICPU_TS+AIV protocol=UB_CTP builder=%s sges=%u batch_wqes=%u window=%u "
                    "samples=%zu warmup=%u aiv_cores=%u service_wait_s=300 ticks_per_ns=1 cqe_per_wqe=%d\n",
                    options.builder == Builder::SimtSgl ? "simt-sgl" : options.builder == Builder::Simt ? "simt" :
                    options.builder == Builder::Vector ? "vector" : "scalar", options.sges,
                    options.batchWqes, options.window, options.blocks.size(), options.warmup, options.cores,
                    options.cqePerWqe);
        std::printf("profile_simt=%d simt_index_refresh=%s simt_index_line_bytes=%u\n", options.profileSimt,
                    options.simtIndexRefresh == SimtIndexRefresh::Line128 ? "line128" : "element",
                    options.simtIndexRefresh == SimtIndexRefresh::Line128 ? 128U : 0U);
        std::signal(SIGPIPE, SIG_IGN);
        const int status = RunRank(rank, options, session);
        // All device streams and explicit ACL/HCCL cleanup have completed above.
        // Do not execute SDK process-global finalizers in a rank or supervisor.
        std::fprintf(stderr, "worker_exit rank=%u pid=%ld status=%d boundary=explicit_cleanup_complete\n",
                     rank, static_cast<long>(getpid()), status);
        std::fflush(stdout);
        std::fflush(stderr);
        _exit(status);
    } catch (const std::exception& error) {
        std::fprintf(stderr, "worker_main_fail rank=%u pid=%ld error=%s\n", rank, static_cast<long>(getpid()), error.what());
        std::fflush(stdout);
        std::fflush(stderr);
        _exit(2);
    }
}
